# --- Azure AD App Registration (created together with the Azure Bot resource) ---
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppType=SingleTenant
MicrosoftAppTenantId=

# --- POC server ---
PORT=3978

# The single hard-coded assignee for this feasibility spike.
ASSIGNEE_EMAIL=approver@cmctssg.space

# --- Email-to-task intake (optional) ---
# A dedicated mailbox this server watches via IMAP. Leave MAILBOX_USER empty to
# disable this feature entirely. Use a mailbox nobody else relies on for daily
# email — the listener only reads (never modifies) messages, but is a spike,
# not hardened for a shared inbox.
MAILBOX_PORT=993
MAILBOX_SECURE=true
MAILBOX_USER=
MAILBOX_POLL_INTERVAL_MS=10000

# --- Option A: Gmail (basic auth — simple) ---
# MAILBOX_HOST=imap.gmail.com
# MAILBOX_SMTP_HOST=smtp.gmail.com
# MAILBOX_AUTH_MODE=basic
# MAILBOX_PASSWORD=<16-char App Password — Google Account > Security > 2-Step
#                    Verification > App passwords. Your normal password will NOT work.
#                    Same App Password works for both IMAP and SMTP, no extra setup.>

# --- Option B: Microsoft 365 / Exchange Online (OAuth2 — required, Basic Auth
# for IMAP/SMTP is disabled on Exchange Online). See README section 7 for the
# full Entra ID + Exchange PowerShell setup this requires — note SMTP needs
# an *additional* permission (SMTP.SendAsApp) beyond what IMAP needed. ---
MAILBOX_HOST=outlook.office365.com
MAILBOX_SMTP_HOST=smtp.office365.com
MAILBOX_SMTP_PORT=587
MAILBOX_AUTH_MODE=oauth2
# Leave these 3 empty to reuse the Bot's own MicrosoftAppId/Password/TenantId
# above (must also be granted the IMAP.AccessAsApp + SMTP.SendAsApp
# permissions — see README). Only set these if using a *different* app
# registration for mailbox access.
MAILBOX_OAUTH_TENANT_ID=
MAILBOX_OAUTH_CLIENT_ID=
MAILBOX_OAUTH_CLIENT_SECRET=

# Only emails whose Subject matches exactly AND whose From address is in this
# list become a task. Comma-separate multiple senders. Senders in this list
# whose Subject does NOT match get an automatic "Subject không đúng" reply.
EMAIL_TASK_SUBJECT=Tạo task mới cho mockBPM
EMAIL_ALLOWED_SENDERS=dinhquangduonghuy@gmail.com

# --- Option C: Microsoft Graph webhook instead of IMAP polling (M365 only) ---
# Pushed notifications instead of polling — see README section 8. Reuses
# MicrosoftAppId/Password/TenantId above, needs Graph "Mail.Read" application
# permission (simpler than IMAP.AccessAsApp: no Exchange PowerShell steps).
# EMAIL_INTAKE_MODE=graph
# GRAPH_NOTIFICATION_URL=https://<current-ngrok-domain>/graph/notifications
# GRAPH_CLIENT_STATE=<any secret string you make up>

# --- Power Automate integration (see docs/power-automate-flows.md) ---
# Shared secret Power Automate must send as the `x-api-key` header on
# POST /bpm/tasks and POST /bpm/tasks/:id/actions — those two endpoints are
# now reachable from the public tunnel, not just in-process code. Leave
# empty to disable the check (open, same as today) — but public/index.html
# and public/my-tasks.html must be updated with the same value if you set one.
BPM_API_KEY=
# HTTP-trigger URL of the Power Automate flow that posts the Teams Adaptive
# Card and waits for a decision ("Flow B"). Power Automate only generates
# this URL after that flow is saved once — leave empty until then; task
# creation just won't notify Teams while empty (see server.ts).
POWER_AUTOMATE_TASK_CREATED_URL=
